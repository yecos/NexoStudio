# NEXO CRM — Neon Postgres
# Vercel/Neon puede usar DATABASE_URL o STORAGE_URL según el prefijo elegido.
DATABASE_URL=
STORAGE_URL=

# URL pública del sitio
NEXT_PUBLIC_SITE_URL=https://www.nexostudioarq.com

# Panel /admin
ADMIN_PASSWORD=
GITHUB_TOKEN=
GITHUB_REPO=yecos/NexoStudio
GITHUB_BRANCH=main

# Captura de leads (opcional)
# Puede apuntar a HubSpot, Make, Zapier, n8n o un endpoint propio.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# HubSpot CRM legado/opcional.
# NEXO CRM usa Neon como fuente principal y no requiere HubSpot.
# HUBSPOT_ACCESS_TOKEN=
# HUBSPOT_DEAL_PIPELINE_ID=
# HUBSPOT_DEAL_STAGE_ID=

# Marketing / Ads (opcionales)
# Ej: G-XXXXXXX o AW-XXXXXXXXX según la etiqueta de Google configurada.
NEXT_PUBLIC_GOOGLE_TAG_ID=
# Valores send_to de las acciones de conversión creadas en Google Ads.
NEXT_PUBLIC_GOOGLE_ADS_LEAD_SEND_TO=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_SEND_TO=
# ID numérico del Meta Pixel.
NEXT_PUBLIC_META_PIXEL_ID=
